# Web
# Active frontend chain. 97 = BSC Testnet, 56 = BNB Smart Chain mainnet.
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_BSC_RPC_URL=
# Public BSC Testnet beta defaults are built into the app; these variables
# override them for another deployment.
NEXT_PUBLIC_FORTUNE_FACTORY_ADDRESS=
NEXT_PUBLIC_FORTUNE_TAX_FACTORY_ADDRESS=
NEXT_PUBLIC_FORTUNE_REGISTRY_ADDRESS=
NEXT_PUBLIC_FORTUNE_POOL_REGISTRY_ADDRESS=
NEXT_PUBLIC_FORTUNE_GRADUATION_ADAPTER_ADDRESS=
NEXT_PUBLIC_FORTUNE_LIQUIDITY_LOCKER_ADDRESS=
NEXT_PUBLIC_FORTUNE_TAX_GRADUATION_ADAPTER_ADDRESS=
NEXT_PUBLIC_FORTUNE_TAX_LIQUIDITY_LOCKER_ADDRESS=
NEXT_PUBLIC_FORTUNE_PRIMARY_QUOTE_ADDRESS=
NEXT_PUBLIC_FORTUNE_PRIMARY_QUOTE_SYMBOL=
NEXT_PUBLIC_FORTUNE_PRIMARY_QUOTE_DECIMALS=18
NEXT_PUBLIC_PANCAKE_V3_FEE_TIER=500
NEXT_PUBLIC_PANCAKE_V2_ROUTER=

# Optional server-side registry enrichment
COINGECKO_API_KEY=

# Contract development / server RPC
# Singular variables remain supported for local development.
BSC_TESTNET_RPC_URL=
BSC_RPC_URL=
# The public testnet beta falls back to two official BNB Chain testnet RPCs
# when these are omitted. Production/mainnet should configure dedicated,
# redundant providers.
BSC_TESTNET_RPC_URLS=
BSC_RPC_URLS=
FORTUNE_REQUIRE_RPC_REDUNDANCY=false

# Mainnet release gate. Keep false until independent security review,
# governance acceptance, production monitoring, and final launch approval.
FORTUNE_MAINNET_RELEASE_APPROVED=false
FORTUNE_GOVERNANCE=
FORTUNE_AUTOMATION_EXECUTOR=
FORTUNE_PROTOCOL_TREASURY=

# Deployment key. Never expose this as a NEXT_PUBLIC variable.
PRIVATE_KEY=


# Optional: Binance Web3 RWA Data API
# Enables Fortune's any-ticker NASDAQ -> BNB tokenized-stock search
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=


# Graduation deployment wiring (verify addresses for the exact target chain)
FORTUNE_FACTORY=
FORTUNE_TAX_FACTORY=
FORTUNE_REGISTRY=
FORTUNE_POOL_REGISTRY=
FORTUNE_V2_TAX_ADAPTER=
FORTUNE_V2_LOCKER=
FORTUNE_V3_ADAPTER=
FORTUNE_V3_LOCKER=
FORTUNE_MOCK_QUOTE=
PANCAKE_V2_ROUTER=
PANCAKE_V3_FACTORY=
PANCAKE_V3_POSITION_MANAGER=

# Runtime readiness checks may also use server-only deployment addresses.
FORTUNE_GRADUATION_ADAPTER=
FORTUNE_LIQUIDITY_LOCKER=


# Production deployment assets (DeployProduction.s.sol)
# PRODUCTION_ASSET_COUNT may be 1-128. Repeat the numbered fields for each slot.
PRODUCTION_ASSET_COUNT=
PRODUCTION_ASSET_0=
PRODUCTION_FEED_0=
PRODUCTION_MAX_AGE_0=
PRODUCTION_QUOTE_ENABLED_0=
PRODUCTION_REWARD_ENABLED_0=
PRODUCTION_GRADUATION_ENABLED_0=
PRODUCTION_CATEGORY_0=

# Exact activation confirmation consumed by ActivateProduction.s.sol.
# Do not set until the governance owner has accepted ownership and all
# production release gates have passed.
CONFIRM_MAINNET_ACTIVATION=
