# Web
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_FORTUNE_FACTORY_ADDRESS=
NEXT_PUBLIC_FORTUNE_REGISTRY_ADDRESS=
NEXT_PUBLIC_FORTUNE_GRADUATION_ADAPTER_ADDRESS=
NEXT_PUBLIC_FORTUNE_LIQUIDITY_LOCKER_ADDRESS=

# Optional server-side registry enrichment
COINGECKO_API_KEY=

# Contract development / server RPC
# Singular variables remain supported for local development.
BSC_TESTNET_RPC_URL=
BSC_RPC_URL=
# Production should configure at least two comma-separated providers.
BSC_TESTNET_RPC_URLS=
BSC_RPC_URLS=
FORTUNE_REQUIRE_RPC_REDUNDANCY=false
PRIVATE_KEY=


# Optional: Binance Web3 RWA Data API
# Enables Fortune's any-ticker NASDAQ -> BNB tokenized-stock search
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=


# Graduation deployment wiring (verify addresses for the exact target chain)
FORTUNE_FACTORY=
FORTUNE_REGISTRY=
PANCAKE_V3_FACTORY=
PANCAKE_V3_POSITION_MANAGER=

# Runtime readiness checks may also use server-only deployment addresses.
FORTUNE_GRADUATION_ADAPTER=
FORTUNE_LIQUIDITY_LOCKER=
